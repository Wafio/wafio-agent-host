# /etc/wafio/host-agent.env — environment for wafio-host-agent.service
#
# Copy to /etc/wafio/host-agent.env and fill in your values.
# After changes: `sudo systemctl restart wafio-host-agent`.
#
# Before starting, compile the eBPF object files on the target Linux host:
#   ARCH_FLAGS="-D__TARGET_ARCH_x86 -I/usr/include/x86_64-linux-gnu"
#   mkdir -p /etc/wafio/ebpf
#   clang -O2 -g -target bpf $ARCH_FLAGS -c internal/ebpf/bpf/wafio_xdp.c   -o /etc/wafio/ebpf/wafio_xdp.o
#   clang -O2 -g -target bpf $ARCH_FLAGS -c internal/ebpf/bpf/wafio_tc.c    -o /etc/wafio/ebpf/wafio_tc.o
#   clang -O2 -g -target bpf $ARCH_FLAGS -c internal/ebpf/bpf/wafio_trace.c -o /etc/wafio/ebpf/wafio_trace.o

# ─── Agent identity (required) ───────────────────────────────────────────────
# Friendly name shown in the dashboard under Hosts.
# Must match the agent name registered in the control plane.
WAFIO_AGENT_NAME=my-host-agent

# Host Key minted in the WAFio dashboard → Hosts → Add Host.
# When set the agent is bound to that registered host row (enables the host
# detail page, firewall UI, and runtime security UI).
WAFIO_HOST_KEY=wafh_replace-me

# ─── mTLS gRPC transport (required) ──────────────────────────────────────────
# Issue mTLS credentials: dashboard → Credentials → Issue Certificate.
# Extract the bundle ZIP and place files under /etc/wafio/certs/host/.

# gRPC endpoint of the WAFio control plane (host:port).
WAFIO_GRPC_SERVER=wafio.example.com:9090

# SNI override for TLS verification.
# Set to "127.0.0.1" when connecting via VPN/internal IP if the server cert
# only has localhost SANs (common in self-hosted deployments).
WAFIO_GRPC_SERVER_NAME=wafio.example.com

# mTLS client certificate, key, and CA (PEM files from the provisioning bundle).
WAFIO_GRPC_CLIENT_CERT=/etc/wafio/certs/host/client.crt
WAFIO_GRPC_CLIENT_KEY=/etc/wafio/certs/host/client.key
WAFIO_GRPC_CA_CERT=/etc/wafio/certs/host/ca.crt

# ─── eBPF kernel firewall ─────────────────────────────────────────────────────
# Network interface to attach XDP/TC to (primary public-facing NIC).
WAFIO_INTERFACE=eth0

# Compiled XDP and TC BPF object files (must be compiled on the target host).
WAFIO_EBPF_XDP_OBJ=/etc/wafio/ebpf/wafio_xdp.o
WAFIO_EBPF_TC_OBJ=/etc/wafio/ebpf/wafio_tc.o

# ─── Runtime security tracing ────────────────────────────────────────────────
# Compiled trace BPF object (eBPF tracepoints for syscall monitoring).
WAFIO_TRACE_OBJ=/etc/wafio/ebpf/wafio_trace.o

# ─── Protected processes (runtime security enforcement) ──────────────────────
# Processes that Kill enforcement policies never terminate. The built-in list
# (sshd, systemd, systemd-journald, containerd, dockerd, kubelet) is always
# kept; the entries below are ADDED to it. The agent refuses to start on an
# invalid entry and logs the effective list at startup:
#   [trace] protected-process set: names=[...] exe_paths=[...] builtin_defaults=merged
#
# Executable basenames, comma-separated. A name protects a process only when
# it runs as root from the host binary in a system directory (/usr/sbin,
# /usr/bin, /usr/lib, /usr/local/bin, ...). No paths, no "..".
# Do not list shells or interpreters (bash, sh, busybox, env, python3, perl,
# node, ...): every root process running them would become unkillable. They
# are accepted but logged as a WARNING and flagged on the self-check line
# (warning=risky_protected:...).
#WAFIO_PROTECTED_PROCESSES=nginx,haproxy
#
# Exact executable paths, comma-separated: absolute, canonical, no "..".
# Protects that host binary whatever user it runs as (use this for daemons
# that run as a service account or live outside the system directories).
#WAFIO_PROTECTED_EXE_PATHS=/usr/lib/postgresql/16/bin/postgres,/opt/acme/bin/agentd
#
# true = REPLACE the built-in names with the entries above instead of
# extending them. Not recommended; requires at least one entry.
#WAFIO_PROTECTED_REPLACE_DEFAULTS=false

# ─── Local API token ────────────────────────────────────────────────────────
# The local API on 127.0.0.1:18089 requires "Authorization: Bearer <token>"
# on every route except /healthz. The token is regenerated each start and
# written root-only (0600) to this file. Read it with:
#   sudo cat /run/wafio/host-agent.token
#WAFIO_LOCAL_API_TOKEN_FILE=/run/wafio/host-agent.token
# Group allowed to read the token (file becomes 0640). Set this to the
# wafio-waf-agent service group so its IP-jail pushes authenticate. The unit
# already has SupplementaryGroups=wafio (no CAP_CHOWN: root can only hand the
# file to a group it is in; otherwise the token stays 0600).
#WAFIO_LOCAL_API_TOKEN_GROUP=wafio

# ─── GeoIP (optional) ────────────────────────────────────────────────────────
# MaxMind GeoLite2-Country.mmdb for geo-blocking enrichment.
WAFIO_GEOIP_DB=/etc/wafio/security-data/geoip/GeoLite2-Country.mmdb
